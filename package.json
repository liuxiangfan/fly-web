    "smoke": "node scripts/browser-smoke.mjs",
    "budget": "node scripts/distbudget.mjs"
  },
  "dependencies": {
    "katex": "^0.19.1",
    "three": "^0.170.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/three": "^0.170.0",
    "c8": "^12.0.0",
    "parse5": "^7.3.0",
    "puppeteer-core": "^23.11.1",
    "sharp": "^0.35.5",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vite": "^5.4.11"
  }
