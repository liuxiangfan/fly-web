{
  "name": "quaternion-attitude-demo",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "selftest": "tsx scripts/selftest.ts",
    "coverage": "c8 --include='src/**/*.ts' --reporter=text npx tsx scripts/selftest.ts",
