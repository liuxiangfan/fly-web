{
  "name": "quaternion-attitude-demo",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "selftest": "tsx scripts/selftest.ts",
    "coverage": "c8 --include='src/**/*.ts' --reporter=text npm run check",
    "scenecheck": "tsx scripts/scenecheck.ts",
    "check": "npm run selftest && npm run scenecheck && npm run htmlcheck && npm run doccheck && npm run contracts && npm run statuscheck && npm run evidence:check",
    "contracts": "tsx scripts/time-contract.test.ts && tsx scripts/schema-contract.test.ts && tsx scripts/doc-search-contract.test.ts && tsx scripts/archive-ui-contract.test.ts && tsx scripts/lifecycle-contract.test.ts && tsx scripts/worker-contract.test.ts && node scripts/trace-contract.test.mjs && node --test scripts/soak-contract.test.mjs scripts/evidence-contract.test.mjs scripts/smoke-verdict.test.mjs scripts/status-contract.test.mjs scripts/budget-contract.test.mjs",
    "htmlcheck": "tsx scripts/htmlcheck.ts",
    "doccheck": "tsx scripts/doccheck.ts",
    "statuscheck": "tsx scripts/statuscheck.ts",
    "evidence:check": "node scripts/evidencecheck.mjs",
    "evidence:verify": "node scripts/evidencecheck.mjs --require-source --require-build",
    "benchmark": "tsx scripts/benchmark.ts",
    "icons": "node scripts/make-icons.mjs",
    "smoke": "node scripts/browser-smoke.mjs",
    "smoke:app": "node scripts/ci-run-smoke.mjs --shard=app --runs=1",
    "smoke:devices": "node scripts/ci-run-smoke.mjs --shard=devices --runs=1",
    "smoke:stability": "node scripts/ci-run-smoke.mjs --shard=both --runs=5",
    "evidence:visual": "node scripts/visual-evidence.mjs",
    "hw:check": "node scripts/hw-check.mjs",
    "hw:soak": "node scripts/hw-soak.mjs",
    "postdeploy:smoke": "node scripts/postdeploy-smoke.mjs",
    "soak": "node scripts/soak.mjs",
    "budget": "node scripts/distbudget.mjs",
    "size:report": "node scripts/size-report.mjs",
    "perf": "node scripts/perf-report.mjs"
  },
  "dependencies": {
    "katex": "^0.19.1",
    "three": "^0.170.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/three": "^0.170.0",
    "c8": "^12.0.0",
    "parse5": "^7.3.0",
    "puppeteer-core": "^23.11.1",
    "sharp": "^0.35.5",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vite": "^5.4.11"
  }
}
